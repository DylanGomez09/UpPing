PROJECT_NAME="UpPing API"
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5433/app_db"

# Seguridad JWT
JWT_SECRET="cambiar-este-secret-en-produccion"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION=30
REFRESH_TOKEN_EXPIRATION_DAYS=30

# CORS: lista JSON de orígenes permitidos (versión web)
CORS_ORIGINS=["http://localhost:3000"]

# Rate limiting de login
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60
